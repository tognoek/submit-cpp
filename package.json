{
  "name": "cpp-judge",
  "version": "1.0.1",
  "private": true,
  "license": "LicenseRef-ChamCpp-Attribution",
  "author": "tognoek <tognoek@gmail.com>",
  "description": "Standalone local C++ judge for Themis-style test packages",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "setup": "node scripts/download-compiler.mjs",
    "dev": "concurrently -n server,web -c cyan,magenta \"npm run dev:server\" \"npm run dev:web\"",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build --config web/vite.config.ts",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "package": "npm run build && node scripts/package.mjs",
    "selftest": "tsx scripts/selftest.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^8.2.0",
    "extract-zip": "^2.0.1",
    "fastify": "^5.4.0",
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "@codemirror/lang-cpp": "^6.0.2",
    "@codemirror/language": "^6.11.0",
    "@codemirror/state": "^6.5.2",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@codemirror/view": "^6.36.8",
    "@replit/codemirror-minimap": "^0.5.2",
    "@tailwindcss/vite": "^4.1.8",
    "@types/jszip": "^3.4.0",
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@uiw/react-codemirror": "^4.23.12",
    "@vitejs/plugin-react": "^4.5.2",
    "concurrently": "^9.1.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.1.8",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
